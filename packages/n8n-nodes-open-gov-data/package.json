{
  "name": "n8n-nodes-open-gov-data",
  "version": "0.1.0",
  "description": "Cost-capped n8n community node for public SEC, ClinicalTrials.gov, UK tenders, openFDA, and Singapore BCA data.",
  "license": "MIT",
  "author": "apify-works contributors",
  "homepage": "https://github.com/fall-rainy/apify-works",
  "repository": {
    "type": "git",
    "url": "https://github.com/fall-rainy/apify-works.git",
    "directory": "codex-work/n8n-community-node-public-data"
  },
  "bugs": {
    "url": "https://github.com/fall-rainy/apify-works/issues"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "apify",
    "rapidapi",
    "open-data",
    "government-data",
    "sec-edgar",
    "clinicaltrials",
    "openfda",
    "uk-tenders",
    "singapore-bca"
  ],
  "main": "dist/nodes/OpenGovData/OpenGovData.node.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec",
    "verify": "node verify.mjs"
  },
  "peerDependencies": {
    "n8n-workflow": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "n8n-workflow": {
      "optional": true
    }
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/OpenGovDataApifyApi.credentials.js",
      "dist/credentials/OpenGovDataRapidApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/OpenGovData/OpenGovData.node.js"
    ]
  }
}

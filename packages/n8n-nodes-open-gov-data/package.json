    "directory": "codex-work/n8n-node-open-gov-v2"
  },
  "bugs": {
    "url": "https://github.com/fall-rainy/apify-works/issues"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "apify",
    "rapidapi",
    "open-data",

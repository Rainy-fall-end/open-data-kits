meta {
  name: ClinicalTrials.gov Studies and Trials
  type: http
  seq: 2
}

get {
  url: https://clinicaltrials-gov-studies-trials.p.rapidapi.com/v1/clinical-trials/studies
  body: none
  auth: none
}

params:query {
  condition: diabetes
  intervention: metformin
  status: RECRUITING
  limit: 5
}

headers {
  Accept: application/json
  X-RapidAPI-Key: {{RAPIDAPI_KEY}}
  X-RapidAPI-Host: clinicaltrials-gov-studies-trials.p.rapidapi.com
}

tests {
  test("HTTP status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("Response has an items array", function () {
    expect(res.getBody().items).to.be.an("array");
  });
}


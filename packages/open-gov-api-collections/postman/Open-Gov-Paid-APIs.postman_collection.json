    {
      "name": "Apify Paid Actors",
      "description": "Four public paid Actors. Every synchronous request has a USD 0.25 server-side charge cap.",
      "item": [
        {
          "name": "SEC EDGAR Filings Actor",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Apify synchronous run completed\", function () {",
                  "  pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "pm.test(\"Response is a bounded dataset item array\", function () {",
                  "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "  const payload = pm.response.json();",
                  "  pm.expect(payload).to.be.an(\"array\");",
                  "  pm.expect(payload.length).to.be.at.most(5);",
                  "});",
                  "pm.test(\"Server-side cost cap remains in the request URL\", function () {",
                  "  pm.expect(pm.request.url.query.get(\"maxTotalChargeUsd\")).to.equal(\"0.25\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{APIFY_TOKEN}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "https://api.apify.com/v2/acts/8LFIbRbidiHPknMz5/run-sync-get-dataset-items?maxTotalChargeUsd=0.25",
              "protocol": "https",
              "host": [
                "api",
                "apify",
                "com"
              ],
              "path": [
                "v2",
                "acts",
                "8LFIbRbidiHPknMz5",
                "run-sync-get-dataset-items"
              ],
              "query": [
                {
                  "key": "maxTotalChargeUsd",
                  "value": "0.25"
                }
              ]
            },
            "description": "Paid Apify Actor request for 8LFIbRbidiHPknMz5. The maxTotalChargeUsd=0.25 query parameter is a server-side hard spend cap.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mode\": \"search\",\n  \"query\": \"artificial intelligence\",\n  \"forms\": \"10-K,10-Q,8-K\",\n  \"startDate\": \"2025-01-01\",\n  \"maxItems\": 5\n}",

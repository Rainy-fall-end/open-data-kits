    {
      "name": "RapidAPI Paid REST APIs",
      "description": "Four read-only RapidAPI endpoints. Subscribe before sending requests.",
      "item": [
        {
          "name": "SEC EDGAR Corporate Filings",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is JSON with a bounded items array\", function () {",
                  "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "  const payload = pm.response.json();",
                  "  pm.expect(payload).to.be.an(\"object\");",
                  "  pm.expect(payload.items).to.be.an(\"array\");",
                  "  pm.expect(payload.items.length).to.be.at.most(5);",
                  "});",
                  "pm.test(\"RapidAPI billing reports returned rows\", function () {",
                  "  pm.expect(pm.response.headers.get(\"X-RapidAPI-Billing\")).to.match(/^Rows=\\d+$/);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-RapidAPI-Key",
                "value": "{{RAPIDAPI_KEY}}",
                "type": "text"
              },
              {
                "key": "X-RapidAPI-Host",
                "value": "sec-edgar-corporate-filings.p.rapidapi.com",
                "type": "text"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "https://sec-edgar-corporate-filings.p.rapidapi.com/v1/sec-edgar/filings?mode=search&query=artificial+intelligence&forms=10-K%2C10-Q%2C8-K&startDate=2025-01-01&limit=5",
              "protocol": "https",
              "host": [
                "sec-edgar-corporate-filings",
                "p",
                "rapidapi",
                "com"
              ],
              "path": [
                "v1",
                "sec-edgar",
                "filings"
              ],
              "query": [
                {
                  "key": "mode",
                  "value": "search"
                },
                {
                  "key": "query",
                  "value": "artificial intelligence"
                },
                {
                  "key": "forms",
                  "value": "10-K,10-Q,8-K"
                },
                {
                  "key": "startDate",
                  "value": "2025-01-01"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            },
            "description": "Paid RapidAPI request for sec-edgar-corporate-filings. Requires an active subscription; sending it may consume quota."
          },
          "response": []

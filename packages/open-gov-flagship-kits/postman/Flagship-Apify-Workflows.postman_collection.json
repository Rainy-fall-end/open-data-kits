  "item": [
    {
      "name": "ATS Jobs & Hiring Signals",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP status is successful\", function () {",
              "  pm.expect(pm.response.code).to.be.within(200, 299);",
              "});",
              "const rows = pm.response.json();",
              "pm.test(\"Response is a dataset array\", function () {",
              "  pm.expect(rows).to.be.an(\"array\");",
              "});",
              "pm.test(\"Result respects maxItems (50)\", function () {",
              "  pm.expect(rows.length).to.be.at.most(50);",
              "});",
              "pm.test(\"Maximum charge is fixed at USD 0.25\", function () {",
              "  const parameter = pm.request.url.query.find(function (item) { return item.key === \"maxTotalChargeUsd\"; });",
              "  pm.expect(parameter && parameter.value).to.eql(\"0.25\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"preset\": \"ai_leaders\",\n  \"keywords\": \"AI, Machine Learning, LLM\",\n  \"remoteOnly\": false,\n  \"departmentFilter\": \"\",\n  \"includeDescription\": false,\n  \"maxItems\": 50\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://api.apify.com/v2/acts/CRulq5dak4mqAUmMn/run-sync-get-dataset-items?format=json&clean=true&maxTotalChargeUsd=0.25",
          "protocol": "https",
          "host": [
            "api",
            "apify",
            "com"
          ],
          "path": [
            "v2",
            "acts",
            "CRulq5dak4mqAUmMn",
            "run-sync-get-dataset-items"
          ],
          "query": [
            {
              "key": "format",
              "value": "json"
            },
            {
              "key": "clean",
              "value": "true"
            },
            {
              "key": "maxTotalChargeUsd",
              "value": "0.25"
            }
          ]
        },
        "description": "Runs the public ATS Jobs & Hiring Signals preset and returns clean JSON dataset items."
      },
